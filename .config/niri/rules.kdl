window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match title="Visual Studio Code"
    open-maximized true
    open-on-workspace "workspace"
}

window-rule {
    match app-id=r#"vesktop$"#
    match app-id=r#"discord$"#
    open-maximized true
    open-on-workspace "miscellaneous"
}

window-rule {
    match app-id=r#"firefox$"#
    open-maximized true
    open-on-workspace "browser"
}
